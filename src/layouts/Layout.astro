---
import "../styles/global.css";
import Footer from "../components/sections/Footer.astro";
import Header from "../components/sections/Header.astro";

type Props = {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    noindex?: boolean;
};

const {
    title = "Manuel Segarra | Software Engineer",
    description = "Software engineer working across backend, cloud and frontend. Projects, experience and contact.",
    image = "/images/og-image.png",
    imageAlt = "Manuel Segarra, Software Engineer",
    noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex" />}
        {!noindex && <link rel="canonical" href={canonical} />}

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:site_name" content="Manuel Segarra" />
        <meta property="og:description" content={description} />
        {!noindex && <meta property="og:url" content={canonical} />}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />

        <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
        <link rel="icon" href="/icons/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

        <link
            rel="preload"
            href="/fonts/scientifica.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <script is:inline>
            let theme = "dark";
            try {
                const saved = localStorage.getItem("theme");
                if (saved === "light" || saved === "dark") {
                    theme = saved;
                }
            } catch {}
            document.documentElement.dataset.theme = theme;
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main-content">
            Skip to content
        </a>
        <Header />
        <main id="main-content" class="container">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .skip-link {
        position: absolute;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 1000;
        padding: 0.6rem;
        background: var(--panel);
        color: var(--text);
        border: 2px solid var(--accent1);
        transform: translateY(-200%);
    }

    .skip-link:focus {
        transform: translateY(0);
    }
</style>
