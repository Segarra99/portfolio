---
const { title } = Astro.props;
const contentId = `window-content-${crypto.randomUUID()}`;
---

<div class="window" data-title={title}>
    <div class="titlebar">
        <span>{title}</span>
        <button
            class="toggle"
            type="button"
            aria-expanded="true"
            aria-controls={contentId}
            aria-label={`Collapse ${title}`}
        >
            [-]
        </button>
    </div>
    <div class="content" id={contentId}>
        <slot />
    </div>
</div>

<script>
    document
        .querySelectorAll<HTMLElement>(".window")
        .forEach((windowElement) => {
            const toggle =
                windowElement.querySelector<HTMLButtonElement>(".toggle");
            const content =
                windowElement.querySelector<HTMLDivElement>(".content");
            const title = windowElement.dataset.title ?? "window";

            if (!toggle || !content) return;

            toggle.addEventListener("click", () => {
                const isCollapsing = !content.classList.contains("collapsed");

                windowElement.style.width = isCollapsing ? "100%" : "";
                content.classList.toggle("collapsed");

                toggle.textContent = isCollapsing ? "[+]" : "[-]";
                toggle.setAttribute("aria-expanded", String(!isCollapsing));
                toggle.setAttribute(
                    "aria-label",
                    `${isCollapsing ? "Expand" : "Collapse"} ${title}`,
                );
            });
        });
</script>

<style>
    .titlebar {
        display: flex;
        justify-content: space-between;
        padding-inline: 0.9rem;
        margin-bottom: 3px;
        background-color: var(--border);
    }

    .toggle {
        box-shadow: none;
        padding: 0;

        &:focus-visible,
        &:active {
            transform: none;
            background-color: var(--accent1);
        }
    }

    .window {
        display: grid;
        grid-template-rows: auto 1fr;
        background-color: var(--border);
        color: var(--bg);
        border: 3px solid var(--border);
        box-shadow: 7px 7px 0 var(--shadow);

        &:has(.content.collapsed) {
            background: transparent;
            border-color: transparent;
            box-shadow: none;

            .titlebar {
                position: relative;
                outline: 3px solid var(--border);
                box-shadow: 7px 7px 0 var(--shadow);

                &::after {
                    content: "";
                    position: absolute;
                    inset: -3px;
                    box-shadow: 7px 7px 0 var(--shadow);
                    pointer-events: none;
                }
            }
    }

    .content {
        display: flex;
        flex-direction: column;
        background-color: var(--panel);

        &.collapsed {
            display: none;
        }
    }

    @media (hover: hover) {
        .toggle:hover {
            transform: none;
            background-color: var(--accent1);
        }
    }
</style>
