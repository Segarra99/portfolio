---
const { title } = Astro.props;
---

<div class="window">
    <div class="titlebar">
        <span>{title}</span>
        <button class="toggle">[_]</button>
    </div>
    <div class="content">
        <slot />
    </div>
</div>

<script>
    document.querySelectorAll<HTMLElement>(".window").forEach((window) => {
        const toggle = window.querySelector<HTMLButtonElement>(".toggle");
        const content = window.querySelector<HTMLDivElement>(".content");

        if (!toggle || !content) return;

        toggle.addEventListener("click", () => {
            const isCollapsing = !content.classList.contains("collapsed");

            window.style.width = isCollapsing ? "100%" : "";

            content.classList.toggle("collapsed");
            toggle.textContent = isCollapsing ? "[+]" : "[-]";
        });
    });
</script>

<style>
    .titlebar {
        display: flex;
        justify-content: space-between;
        padding-inline: 0.9rem;
        margin-bottom: 3px;
        background-color: var(--border);
    }

    .toggle {
        box-shadow: none;
        padding: 0;

        &:hover {
            transform: none;
            background-color: var(--accent1);
        }
    }

    .window {
        display: grid;
        grid-template-rows: auto 1fr;
        background-color: var(--border);
        color: var(--bg);
        border: 3px solid var(--border);
        box-shadow: 7px 7px 0 var(--shadow);
    }

    .content {
        display: flex;
        flex-direction: column;
        background-color: var(--panel);

        &.collapsed {
            display: none;
        }
    }

    .window:has(.content.collapsed) {
        background: transparent;
        border-color: transparent;
        box-shadow: none;

        .titlebar {
            position: relative;
            outline: 3px solid var(--border);
            box-shadow: 7px 7px 0 var(--shadow);

            &::after {
                content: "";
                position: absolute;
                inset: -3px;
                box-shadow: 7px 7px 0 var(--shadow);
                pointer-events: none;
            }
        }
    }
</style>
