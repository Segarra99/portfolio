---
import type { SkillGroup } from "../../../data/skills";
type Props = {
    group: SkillGroup;
};
const { category, skills } = Astro.props.group;
---

<details open>
    <summary>
        <span class="indicator" aria-hidden="true"></span>
        <span class="category">{category}/</span>
        <span class="length">({skills.length})</span>
    </summary>
    <ul>
        {skills.map((skill, index, array) => (
            <li class:list={{ highlight: skill.highlighted }}>
                {index === array.length - 1 ? "`--" : "|--"} {skill.name}
            </li>
        ))}
    </ul>
</details>

<style>
    details[open] .indicator::before {
        content: "[-]";
    }

    summary {
        display: flex;
        gap: 0.7rem;
        list-style: none;
        cursor: pointer;
        user-select: none;

        &:focus {
            outline: none;
        }

        &:hover .indicator,
        &:focus-visible .indicator {
            background-color: var(--accent1);
            color: var(--panel);
        }

        .indicator {
            color: var(--accent1);

            &::before {
                content: "[+]";
            }
        }

        .category {
            color: var(--accent2);
        }

        .length {
            color: var(--dim);
        }
    }

    ul {
        color: var(--sub);
        padding-left: 2rem;

        .highlight {
            color: var(--accent1);
        }
    }
</style>
