---
import { experiences } from "../../../data/experience";
import ExperienceEntry from "./ExperienceEntry.astro";
---

<section id="experience">
    <h2>git log --experience</h2>
    <ol>
        {experiences.map((experience) => (
            <li>
                <ExperienceEntry experience={experience} />
            </li>
        ))}
    </ol>
</section>

<style>
    h2 {
        color: var(--accent2);
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        font-weight: 500;
        margin: 3rem 0 1.5rem;

        &::before {
            content: "$ ";
            color: var(--accent1);
        }
    }

    ol {
        position: relative;
        border-left: 3px dashed var(--accent1);
        margin-left: 0.5rem;
        padding-left: 1.8rem;

        li + li {
            padding-top: 2rem;
        }
    }
</style>
