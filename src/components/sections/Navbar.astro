---
const links = [
    { href: "/#about", label: "./about" },
    { href: "/#projects", label: "./projects" },
    { href: "/#experience", label: "./experience" },
    { href: "/#skills", label: "./skills" },
    { href: "/#contact", label: "./contact" },
];
---

<nav>
    <a class="brand" href={Astro.url.pathname === "/" ? "#top" : "/"}>
        segarra@dev:~$
    </a>

    <button class="menu-toggle" type="button">
        [ menu ]
    </button>

    <ul class="nav-links">
        {links.map(({ href, label }) => (
            <li>
                <a href={href}>{label}</a>
            </li>
        ))}
        <li class="theme-toggle">
            <span></span>
            <button type="button"></button>
        </li>
    </ul>
</nav>

<script>
    // menu
    const menuToggle =
        document.querySelector<HTMLButtonElement>(".menu-toggle");
    const navLinks = document.querySelector<HTMLUListElement>(".nav-links");

    if (menuToggle && navLinks) {
        menuToggle.addEventListener("click", () => {
            const isOpen = navLinks.classList.toggle("open");
            menuToggle.textContent = isOpen ? "[ close ]" : "[ menu ]";
        });

        navLinks.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                navLinks.classList.remove("open");
                menuToggle.textContent = "[ menu ]";
            });
        });
    }

    // theme
    const themeToggle = document.querySelector<HTMLButtonElement>(
        ".theme-toggle button",
    );
    const root = document.documentElement;

    if (themeToggle) {
        themeToggle.textContent = `[${root.dataset.theme}]`;
        themeToggle.addEventListener("click", () => {
            // add theme switch class to root for transition animation
            root.classList.add("theme-switch");

            // handle theme switch
            const theme = root.dataset.theme === "light" ? "dark" : "light";
            root.dataset.theme = theme;
            localStorage.setItem("theme", theme);
            themeToggle.textContent = `[${theme}]`;

            // remove theme switch class after animation is over (timeout matches global css rule)
            setTimeout(() => {
                root.classList.remove("theme-switch");
            }, 500);
        });
    }
</script>

<style>
    nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
    }

    .brand {
        color: var(--accent2);
        font-size: clamp(1.5rem, 7vw, 1.75rem);
        white-space: nowrap;

        &::after {
            content: "";
            display: inline-block;
            width: 0.7rem;
            height: 1.2rem;
            vertical-align: -0.1em;
            background: var(--accent1);
            animation: blink 1s steps(2, start) infinite;
        }

        &:hover {
            border-color: var(--accent1);
            background: var(--accent1);
            color: var(--panel);
        }
    }

    .menu-toggle {
        padding: clamp(0.25rem, 1vw, 0.4rem) clamp(0.5rem, 2.5vw, 0.9rem);
        border: 3px solid var(--border);
        white-space: nowrap;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        flex-direction: column;
        border-bottom: 3px solid var(--border);
        background: var(--panel);
        box-shadow: 0 6px 0 var(--shadow);

        &.open {
            display: flex;
        }

        a {
            display: block;
            padding: 0.9rem 1.5rem;
            border-top: 2px dashed var(--line);

            &:hover {
                background: var(--accent1);
                color: var(--panel);
                border-color: var(--accent1);
            }
        }
    }

    .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 0.5rem 1.5rem;
        border-top: 3px solid var(--border);

        span::before {
            content: "theme";
            color: var(--dim);
        }

        button {
            padding: 0.2rem 0.8rem;
            border: 2px solid transparent;
            color: var(--accent1);
            transform: none;
            box-shadow: none;

            &:hover {
                border-color: var(--accent2);
            }
        }
    }

    @keyframes blink {
        to {
            visibility: hidden;
        }
    }

    @media (min-width: 1080px) {
        .menu-toggle {
            display: none;
        }

        .nav-links {
            display: flex;
            position: static;
            flex-direction: row;
            align-items: center;
            gap: 0.3rem;
            border: none;
            box-shadow: none;

            a {
                padding: 0.2rem 0.8rem;
                border: 2px solid transparent;

                &:hover {
                    border-color: var(--accent2);
                    background: transparent;
                    color: var(--accent2);
                }
            }
        }

        .theme-toggle {
            width: auto;
            padding: 0;
            border: none;
            gap: 0.3rem;

            span {
                display: block;
                height: 1.8rem;
                margin-inline: 0.5rem;
                border-left: 2px dashed var(--line);

                &::before {
                    content: none;
                }
            }
        }
    }
</style>
