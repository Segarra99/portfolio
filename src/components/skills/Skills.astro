---
import { skills } from "../../data/skills";
import SkillTree from "./SkillTree.astro";
---

<section id="skills">
    <h2>$ tree skills/</h2>
    <div class="box">
        <span>skills/</span>
        <ul>
            {skills.map((group) => (
                <li>
                    <SkillTree group={group} />
                </li>
            ))}
        </ul>
    </div>
</section>
